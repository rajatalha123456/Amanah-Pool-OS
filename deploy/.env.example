# Copy to deploy/.env and fill in. Never commit the real .env.
SITE_ADDRESS=demo.example.com
DEMO_MODE=true

DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=demo.example.com
CORS_ALLOWED_ORIGINS=https://demo.example.com
SECURE_SSL_REDIRECT=True

DB_NAME=amanah
DB_USER=amanah
DB_PASSWORD=change-me-too

# Demo: logins without an authenticator app. Set True for anything beyond a demo.
MFA_ENFORCED=False
ALLOW_SIMULATED_INTEGRATIONS=False
AUTH_THROTTLE_RATE=10/min

# Shariah copilot (runs inside the backend). One provider: anthropic | gemini | ollama. Without a working key the AI screens
# answer "unavailable"; nothing else is affected.
COPILOT_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_HOST=
COPILOT_MODEL_CACHE_DIR=/app/data/models
COPILOT_RAW_DOCS_DIR=/app/data/raw_documents
